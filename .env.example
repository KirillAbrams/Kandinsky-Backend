# Сначала запусти python3 tools/configure.py. Затем заполни нужные настройки
# в местном файле .env. Этот пример оставляй без закрытых значений.

# Эти значения создаёт tools/configure.py.
# POSTGRES_PASSWORD
# STUDIO_MIGRATION_PASSWORD
# STUDIO_API_PASSWORD
# STUDIO_WORKER_PASSWORD
# STUDIO_BRIDGE_ERASURE_KEY
# demo создаёт примеры для разработки. kandinsky отправляет задание настоящей модели.
STUDIO_PROVIDER=kandinsky
STUDIO_STARTER_HISTORY=true
# Укажи адрес запущенной службы и тот же ключ, что у её исполнителя.
STUDIO_GPU_URL=
STUDIO_GPU_TOKEN=
STUDIO_VIDEO_SR_ENABLED=false
STUDIO_MODERATION_MODE=off
STUDIO_MODERATION_ORIGIN=
STUDIO_MODERATION_TOKEN=

# Настройки SMTP и отдельный секрет для кодов регистрации и восстановления.
STUDIO_PASSWORD_RESET_SECRET=
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_SECURITY=starttls
STUDIO_SMTP_FROM=
STUDIO_SMTP_USER=
STUDIO_SMTP_PASSWORD=
